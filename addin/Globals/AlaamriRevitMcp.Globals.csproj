<Project Sdk="Microsoft.NET.Sdk">
  <!-- Script globals live in their own tiny assembly so that the isolated Roslyn engine and the compiled
       scripts both bind to ONE copy of the type (loaded in Revit's default context). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AlaamriRevitMcp.Globals</AssemblyName>
    <RootNamespace>Alaamri.RevitMcp</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Dr Ibrahim M.A. Alaamri</Authors>
    <PlatformTarget>x64</PlatformTarget>
    <RevitDir Condition="'$(RevitDir)' == ''">C:\Program Files\Autodesk\Revit 2027</RevitDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
