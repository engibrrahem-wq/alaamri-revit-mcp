<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AlaamriRevitMcp</AssemblyName>
    <RootNamespace>Alaamri.RevitMcp</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Dr Ibrahim M.A. Alaamri</Authors>
    <Company>Dr Ibrahim M.A. Alaamri</Company>
    <Product>Alaamri Revit MCP</Product>
    <Copyright>Copyright (c) 2026 Dr Ibrahim M.A. Alaamri</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Globals\**" />
    <ProjectReference Include="Globals\AlaamriRevitMcp.Globals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

</Project>
